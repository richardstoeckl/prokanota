            conda:
                os.path.join(workflow.basedir, "envs", "diamond.yaml")
            threads: max(1, int(workflow.cores * 0.5))  # Use safe threads calculation
            params:
                db_path=db["db_path"],
                db_name=db_name,
                evalue_cutoff=db.get("evalue_cutoff", 1e-3),
