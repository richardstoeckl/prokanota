# Dynamic Parse Rules
# =============================================================================

for db in ENABLED_DBS:
    db_name = db["name"]

    if db["search_tool"] == "pyhmmer":

        rule:
            name:
                f"parse_{db_name}"
            input:
                tblout=os.path.join(INTERIMPATH, "{id}", db_name, "hits.tblout"),
                mapping=db["mapping_path"],
            output:
                tsv=os.path.join(INTERIMPATH, "{id}", db_name, "parsed_annotation.tsv"),
            log:
                os.path.join(LOGPATH, "{id}", "parse", f"parse_{db_name}.log"),
            conda:
                os.path.join(
                    workflow.basedir,
                    "envs",
                    "polars_arm.yaml" if IS_ARM else "polars.yaml",
                )
            threads: 1  # Parsing is single-threaded
            params:
                db_name=db_name,
                mapping_key=db.get("mapping_key", "accession"),
                evalue_cutoff=db.get("evalue_cutoff", 1e-3),
                columns_json=get_columns_json(db),
            message:
                f"Parsing {{wildcards.id}} {db_name} results"
            shell:
                """
                python {workflow.basedir:q}/scripts/pyhmmer_parse.py \
                    --tblout {input.tblout:q} \
                    --mapping {input.mapping:q} \
                    --output {output.tsv:q} \
                    --db-name {params.db_name:q} \
                    --mapping-key {params.mapping_key:q} \
                    --evalue-cutoff {params.evalue_cutoff} \
                    --columns {params.columns_json:q} \
                """ + LOG_REDIRECT

    elif db["search_tool"] == "rpsblast":

        rule:
            name:
                f"parse_{db_name}"
            input:
                rpsblast_output=os.path.join(INTERIMPATH, "{id}", db_name, "hits.tsv"),
