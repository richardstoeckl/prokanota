    elif db["search_tool"] == "diamond":

        rule:
            name:
                f"search_{db_name}"
            input:
                faa=os.path.join(RESULTPATH, "{id}", "features", "{id}.faa"),
            output:
                tab=temp(os.path.join(INTERIMPATH, "{id}", db_name, "hits.tsv")),
